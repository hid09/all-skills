{
  // Prism V4.2 provider config example.
  // Copy selected provider blocks to ~/.prism/providers.json.
  // Do not put API keys here; store them in ~/.prism/keys.env or process env.
  "config_version": "1.0",
  "providers": {
    "tokenopen": {
      "api_style": "openai-compatible",
      "base_url": "https://www.tokenopen.ai",
      "chat_path": "/v1/chat/completions",
      "auth_type": "bearer",
      "key_env": "PRISM_TOKENOPEN_KEY",
      "base_env": "PRISM_TOKENOPEN_BASE",
      "extra_headers": {},
      "request_defaults": { "temperature": 0.7, "max_tokens": 8000 },
      "timeout_seconds": 60,
      "retry": {
        "max_attempts": 3,
        "retry_on_status": [429, 503, 504],
        "retry_on_body_match": ["fake_sse_empty_response"],
        "backoff_seconds": [2, 5]
      }
    },
    "deepseek": {
      "api_style": "openai-compatible",
      "base_url": "https://api.deepseek.com",
      "chat_path": "/v1/chat/completions",
      "auth_type": "bearer",
      "key_env": "PRISM_DEEPSEEK_KEY",
      "base_env": "PRISM_DEEPSEEK_BASE",
      "extra_headers": {},
      "request_defaults": { "temperature": 0.7, "max_tokens": 8000 },
      "timeout_seconds": 60,
      "retry": {
        "max_attempts": 3,
        "retry_on_status": [400, 429, 503, 504],
        "retry_on_body_match": [],
        "backoff_seconds": [2, 5]
      }
    },
    "moonshot": {
      "api_style": "openai-compatible",
      "base_url": "https://api.moonshot.cn",
      "chat_path": "/v1/chat/completions",
      "auth_type": "bearer",
      "key_env": "PRISM_MOONSHOT_KEY",
      "base_env": "PRISM_MOONSHOT_BASE",
      "extra_headers": {},
      "request_defaults": { "temperature": 0.6, "max_tokens": 8000 },
      "timeout_seconds": 60,
      "retry": { "max_attempts": 3, "retry_on_status": [429, 503, 504], "retry_on_body_match": [], "backoff_seconds": [2, 5] }
    },
    "zhipu": {
      "api_style": "openai-compatible",
      "base_url": "https://open.bigmodel.cn/api/paas",
      "chat_path": "/v4/chat/completions",
      "auth_type": "bearer",
      "key_env": "PRISM_ZHIPU_KEY",
      "base_env": "PRISM_ZHIPU_BASE",
      "extra_headers": {},
      "request_defaults": { "temperature": 0.7, "max_tokens": 8000 },
      "timeout_seconds": 60,
      "retry": { "max_attempts": 3, "retry_on_status": [429, 503, 504], "retry_on_body_match": [], "backoff_seconds": [2, 5] }
    },
    "openrouter": {
      "api_style": "openai-compatible",
      "base_url": "https://openrouter.ai/api",
      "chat_path": "/v1/chat/completions",
      "auth_type": "bearer",
      "key_env": "PRISM_OPENROUTER_KEY",
      "base_env": "PRISM_OPENROUTER_BASE",
      "extra_headers": {
        "HTTP-Referer": "https://prism.local",
        "X-Title": "Prism"
      },
      "request_defaults": { "temperature": 0.7, "max_tokens": 8000 },
      "timeout_seconds": 90,
      "retry": { "max_attempts": 3, "retry_on_status": [429, 503, 504], "retry_on_body_match": [], "backoff_seconds": [2, 5] }
    },
    "ollama": {
      "api_style": "openai-compatible",
      "base_url": "http://localhost:11434",
      "chat_path": "/v1/chat/completions",
      "auth_type": "bearer",
      "key_env": "PRISM_OLLAMA_KEY",
      "base_env": "PRISM_OLLAMA_BASE",
      "extra_headers": {},
      "request_defaults": { "temperature": 0.7, "max_tokens": 8000 },
      "timeout_seconds": 120,
      "retry": { "max_attempts": 2, "retry_on_status": [503, 504], "retry_on_body_match": [], "backoff_seconds": [2] }
    }
  }
}
