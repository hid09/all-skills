# Copy to ~/.prism/keys.env or scripts/keys.env, then fill real values locally.
# Do not commit real keys.
#
# Lookup order:
# 1. process env
# 2. ~/.prism/keys.env
# 3. ~/.claude/skills/prism/scripts/keys.env

PRISM_TOKENOPEN_KEY=sk-your-tokenopen-key
PRISM_TOKENOPEN_BASE=https://www.tokenopen.ai

PRISM_DEEPSEEK_KEY=sk-your-deepseek-key
PRISM_DEEPSEEK_BASE=https://api.deepseek.com

# Optional third provider example:
# PRISM_OPENROUTER_KEY=sk-your-openrouter-key
# PRISM_OPENROUTER_BASE=https://openrouter.ai/api
