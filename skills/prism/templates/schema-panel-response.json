{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "prism/schema-panel-response.json",
  "title": "panel.ps1 输出契约 (out.json)",
  "description": "V4.1 §7.3 / §10.4 — panel.ps1 执行完成后写入的 JSON 文件结构。⚠️ 单家失败不影响其他家（fault-tolerant）。",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {
            "type": "string",
            "description": "对应 in.json 的 request.id"
          },
          "status": {
            "type": "string",
            "enum": ["success", "failed", "timeout", "invalid_response"],
            "description": "success: 200 且内容合法；failed: HTTP 4xx/5xx 或异常；timeout: 超时；invalid_response: 内容不符合 schema"
          },
          "content": {
            "type": ["object", "string", "null"],
            "description": "status=success 时为解析后的 JSON 或原始文本；其他状态为 null"
          },
          "raw_content": {
            "type": "string",
            "description": "仅在 panel.ps1 显式传入 -IncludeRawContent 时写入；可能含用户或供应商敏感内容，默认应为空，不得归档或分享"
          },
          "tokens_used": {
            "type": "object",
            "properties": {
              "prompt_tokens": { "type": "integer" },
              "completion_tokens": { "type": "integer" },
              "total_tokens": { "type": "integer" }
            }
          },
          "latency_ms": {
            "type": "integer",
            "minimum": 0,
            "description": "从发起请求到收到响应的耗时"
          },
          "error": {
            "type": ["string", "null"],
            "description": "status != success 时的错误摘要"
          },
          "retry_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "已重试次数（若 panel.ps1 支持重试）"
          },
          "provider": {
            "type": "string",
            "description": "实际用的供应商 endpoint",
            "examples": ["tokenopen", "deepseek"]
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "started_at": { "type": "string" },
        "finished_at": { "type": "string" },
        "total_duration_ms": { "type": "integer" },
        "concurrency_mode": {
          "type": "string",
          "enum": ["parallel-ps7", "sequential-ps51-fallback", "sequential-explicit"]
        }
      }
    }
  }
}
